# Copia este archivo como .env y edítalo. El .env nunca se sube a GitHub.

# ---------- Base de datos ----------
INVENTARIO_DB=inventario.db

# ---------- API (solo si usas n8n u otro sistema) ----------
# 127.0.0.1 = solo esta PC. Usa 0.0.0.0 únicamente para tu red local.
API_HOST=127.0.0.1
API_PORT=5000
# Clave de al menos 24 caracteres (la API no arranca con una más corta). Para generarla:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# Orígenes web permitidos (separados por coma). Vacío = ninguno.
CORS_ORIGINS=
N8N_WEBHOOK_URL=

# ---------- Inteligencia artificial (opcional) ----------
# local      -> modo básico: sin internet, sin costo, tus datos no salen de tu PC
# openai | anthropic | gemini | groq | openrouter | deepseek | mistral | together
# ollama | lmstudio   -> modelos gratis que corren en tu PC (no necesitan key)
# compatible          -> cualquier API estilo OpenAI (define AI_BASE_URL)
AI_PROVIDER=local
AI_API_KEY=
# Opcional: si lo dejas vacío se usa un modelo económico por defecto.
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT=30
